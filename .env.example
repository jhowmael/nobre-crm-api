# Copie para .env (cp .env.example .env) e ajuste. O .env nunca vai para o Git.

# --- PostgreSQL (usado pelo docker-compose.yml) ---
POSTGRES_USER=nobre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nobre_crm
# Porta do PostgreSQL no seu computador. 5433 evita colidir com um PostgreSQL já instalado na 5432.
POSTGRES_PORT=5433

# --- Conexão usada pela API, pelas migrations e pelo seed rodando fora do Docker ---
# Usuário, senha, porta e banco precisam ser os mesmos de cima.
DATABASE_URL=postgresql://nobre:change-me@localhost:5433/nobre_crm?schema=public

# Banco exclusivo dos testes de integração (os dados dele são apagados a cada execução).
TEST_DATABASE_URL=postgresql://nobre:change-me@localhost:5433/nobre_crm_test?schema=public
# Banco auxiliar, só para conferir migrations (prisma migrate diff). Pode ficar vazio.
SHADOW_DATABASE_URL=

# --- API ---
PORT=3333
# Origens do frontend permitidas, separadas por vírgula.
CORS_ORIGIN=http://localhost:3000
# Data de referência do case. Apague ou deixe vazio para usar a data real.
APP_TODAY=2026-10-15

# --- Segurança ---
# Quando preenchida, toda rota exige o cabeçalho x-api-key (exceto /health e /docs).
API_KEY=
# Limite de requisições por IP: quantidade por janela, e tamanho da janela em segundos.
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
